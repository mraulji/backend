COS_ENDPOINT=https://s3.<region>.cloud-object-storage.appdomain.cloud
COS_API_KEY=your-ibm-cloud-api-key-here
COS_RESOURCE_INSTANCE_ID=crn:v1:bluemix:public:cloud-object-storage:global:a/your-account-id:your-instance-id::
COS_BUCKET_NAME=your-bucket-name

# COS credentials for requirement documents
COS_REQUIREMENT_ENDPOINT=https://s3.<region>.cloud-object-storage.appdomain.cloud
COS_REQUIREMENT_API_KEY=your-requirement-api-key-here
COS_REQUIREMENT_RESOURCE_INSTANCE_ID=crn:v1:bluemix:public:cloud-object-storage:global:a/your-account-id:your-instance-id::
COS_REQUIREMENT_BUCKET_NAME=your-requirement-bucket-name

PORT=3000
